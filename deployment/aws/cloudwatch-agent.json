{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": "TradingDashboard",
    "append_dimensions": {"InstanceId": "${aws:InstanceId}"},
    "metrics_collected": {
      "mem": {
        "measurement": ["mem_used_percent"],
        "metrics_collection_interval": 60
      },
      "disk": {
        "measurement": ["used_percent"],
        "resources": ["/", "/var/lib/trading"],
        "drop_device": true,
        "metrics_collection_interval": 60
      }
    }
  },
  "logs": {
    "force_flush_interval": 5,
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/lib/trading/logs/app-*.log",
            "log_group_name": "__APP_LOG_GROUP__",
            "log_stream_name": "{instance_id}/app",
            "timezone": "Local"
          },
          {
            "file_path": "/var/lib/trading/logs/orders-*.log",
            "log_group_name": "__APP_LOG_GROUP__",
            "log_stream_name": "{instance_id}/orders",
            "timezone": "Local"
          },
          {
            "file_path": "/var/lib/trading/logs/access-*.log",
            "log_group_name": "__APP_LOG_GROUP__",
            "log_stream_name": "{instance_id}/access",
            "timezone": "Local"
          },
          {
            "file_path": "/var/lib/trading/logs/errors-*.log",
            "log_group_name": "__APP_LOG_GROUP__",
            "log_stream_name": "{instance_id}/errors",
            "timezone": "Local"
          },
          {
            "file_path": "/var/log/cloud-init-output.log",
            "log_group_name": "__SYSTEM_LOG_GROUP__",
            "log_stream_name": "{instance_id}/cloud-init"
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "__SYSTEM_LOG_GROUP__",
            "log_stream_name": "{instance_id}/nginx-error"
          }
        ]
      }
    }
  }
}
